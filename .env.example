# ============================================================
# Sevelin POS — Variables de entorno (PLANTILLA)
# ------------------------------------------------------------
# Copia este archivo como .env para desarrollo local y complétalo con
# TUS valores. NUNCA subas el .env real a git ni lo compartas por chat.
# En producción, estas variables van en Vercel → Settings → Environment
# Variables (no en un archivo).
# ============================================================

# --- Servidor y base de datos (Supabase) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
# Llave SECRET moderna (sb_secret_...) o service_role. Nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu_secret_key_aqui

# --- Autenticación y sesiones (backend Node/Express) ---
# Genera una cadena larga: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_jwt_secret_aleatorio_de_64_caracteres_aqui

# --- PINs de acceso ---
# NO uses 1234/5678 ni 9067/0495: el backend rechaza esos valores de ejemplo.
# Admiten letras, números y símbolos (v6). Usa claves propias.
ADMIN_PIN=cambia_esto
WORKER_PIN=cambia_esto_tambien

# --- CORS: orígenes permitidos, separados por coma (sin espacios) ---
CORS_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:3000

# --- Entorno ---
PORT=3000
NODE_ENV=development

# --- Sincronización con sevelin-tienda (e-commerce, repo aparte) ---
# Mismo valor que SYNC_SECRET en las variables de entorno de sevelin-tienda.
# Protege POST /api/interno/ajustar-stock (Fase 3): lo llama el backend de la
# tienda tras confirmar un pago con Flow, no una persona logueada.
SYNC_SECRET=cadena-larga-y-aleatoria-compartida-con-la-tienda
# Solo para scripts/sincronizar-catalogo-web.js (carga masiva única del
# catálogo ya publicado antes de configurar el webhook) — no la usa
# api/index.js. URL real de sevelin-tienda + /api/sync/producto.
TIENDA_SYNC_URL=https://sevelin-tienda.vercel.app/api/sync/producto

# --- Panel "Pedidos Web" (Fase 5) ---
# Credenciales del proyecto Supabase WEB de sevelin-tienda (NO son las de
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY de arriba, que son del POS). Se usan
# SOLO para leer/actualizar pedidos_web desde el panel — nunca se mezclan con
# el Supabase del POS.
SUPABASE_WEB_URL=https://tu-proyecto-web.supabase.co
SUPABASE_WEB_SERVICE_ROLE_KEY=tu_secret_key_de_supabase_web_aqui

# --- Marca del negocio (sale impresa en el ticket) ---
NEGOCIO_NOMBRE=Sevelin
